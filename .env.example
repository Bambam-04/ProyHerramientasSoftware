# Copia este archivo como .env y ajusta usuario, contraseña y nombre de la base
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/cima"
JWT_SECRET=""
DOMINIO_INSTITUCIONAL="uabc.edu.mx"
PORT=3000
CIMA_TIMEZONE="America/Tijuana"
HTTPS_PORT=3443
# npm run setup genera un secreto aleatorio y certificados locales en .local/tls.
# En producción usa certificados emitidos para tu dominio y NODE_ENV=production.
# TLS_KEY_FILE="/ruta/privkey.pem"
# TLS_CERT_FILE="/ruta/fullchain.pem"
# PUBLIC_ORIGIN="https://cima.institucion.edu.mx"
# HOST="0.0.0.0"
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
# BACKUP_DIR=".local/backups"
# SESSION_TTL="2h"
# Sólo al usar un proxy HTTPS de confianza: TRUST_PROXY=1
