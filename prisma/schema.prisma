generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ALUMNO
  DOCENTE
  ENCARGADO
  ADMIN
}

enum EstadoMaterial {
  ACTIVO
  MANTENIMIENTO
  BAJA
}

enum EstadoPrestamo {
  PENDIENTE
  PREPARADA
  ENTREGADO
  DEVUELTO
  RECHAZADO
  CANCELADO
  NO_RECOGIDO
  INCIDENCIA
}

enum Condicion {
  BUENO
  INTEGRO
  RAYADO
  ASTILLADO
  DANADO
  ROTO
  PERDIDO
}

enum EstadoPieza {
  DISPONIBLE
  RESERVADA
  PRESTADA
  MANTENIMIENTO
  BAJA
  PERDIDA
}

// Padrón de alumnos y docentes activos (simula la validación institucional)
model Padron {
  matricula String  @id
  nombre    String
  rol       Rol
  activo    Boolean @default(true)
  correo    String?
  carrera   String?
  periodo   String?
}

model Usuario {
  id             Int        @id @default(autoincrement())
  matricula      String     @unique
  nombre         String
  correo         String     @unique
  passwordHash   String
  rol            Rol
  activo         Boolean @default(true)
  bloqueo        Boolean @default(false)
  carrera        String?
  periodo        String?
  fotografia     String?
  debeCambiarPassword Boolean @default(false)
  sessionVersion Int @default(0)
  intentos       Int        @default(0)
  bloqueadoHasta DateTime?
  creadoEn       DateTime   @default(now())
  prestamos      Prestamo[]
  incidencias    Incidencia[]
  adeudos        Adeudo[]
  convenios      Convenio[]
  notificaciones Notificacion[]
  intereses      Interes[]

  @@index([rol, activo])
}

model Material {
  id            Int            @id @default(autoincrement())
  nombre        String
  cantidadTotal Int
  estado        EstadoMaterial @default(ACTIVO)
  categoria     String @default("General")
  caracteristicas String @default("")
  fotografia    String?
  maxHoras      Int @default(24)
  prestamos     Prestamo[]
  piezas        Pieza[]
  intereses     Interes[]

  @@index([estado, nombre])
  @@index([categoria])
}

model Prestamo {
  id                Int            @id @default(autoincrement())
  usuarioId         Int
  materialId        Int?
  cantidad          Int @default(1)
  estado            EstadoPrestamo @default(PENDIENTE)
  fechaSolicitud    DateTime       @default(now())
  fechaEntrega      DateTime?
  fechaDevolucion   DateTime?
  fechaRecoleccion  DateTime?
  fechaPreparacion DateTime?
  limiteRecogida    DateTime?
  codigo           String? @unique
  identidadVerificada Boolean @default(false)
  encargadoEntregaId Int?
  encargadoDevolucionId Int?
  fechaAvisoVencimiento DateTime?
  fechaDevuelto     DateTime?
  condicionEntrega  Condicion?
  condicionDevuelto Condicion?
  notasEntrega      String?
  notasDevuelto     String?
  usuario           Usuario        @relation(fields: [usuarioId], references: [id])
  material          Material?      @relation(fields: [materialId], references: [id])
  piezas            PrestamoPieza[]
  incidencias       Incidencia[]
  defectos          DefectoPrevio[]

  @@index([estado, fechaSolicitud, id])
  @@index([usuarioId, fechaSolicitud])
  @@index([estado, limiteRecogida])
  @@index([estado, fechaDevolucion])
}

model Pieza {
  id             Int @id @default(autoincrement())
  codigo         String @unique
  materialId     Int
  estado         EstadoPieza @default(DISPONIBLE)
  condicion      Condicion @default(INTEGRO)
  material       Material @relation(fields: [materialId], references: [id])
  piezasPrestamo PrestamoPieza[]
  @@index([materialId, estado])
}

model PrestamoPieza {
  id                Int @id @default(autoincrement())
  prestamoId        Int
  piezaId           Int
  condicionEntrega  Condicion?
  condicionDevuelto Condicion?
  notasEntrega      String?
  notasDevuelto     String?
  devuelta          Boolean @default(false)
  prestamo          Prestamo @relation(fields: [prestamoId], references: [id])
  pieza             Pieza @relation(fields: [piezaId], references: [id])
  defectos          DefectoPrevio[]
  incidencia        Incidencia?
  @@unique([prestamoId, piezaId])
  @@index([piezaId])
}

model DefectoPrevio {
  id               Int @id @default(autoincrement())
  prestamoId       Int
  prestamoPiezaId  Int
  descripcion      String
  condicion        Condicion
  estado           String @default("PENDIENTE")
  respuesta        String?
  encargadoId      Int?
  creadoEn         DateTime @default(now())
  resueltoEn       DateTime?
  prestamo         Prestamo @relation(fields: [prestamoId], references: [id])
  piezaPrestamo    PrestamoPieza @relation(fields: [prestamoPiezaId], references: [id])
  @@index([estado])
}

model Incidencia {
  id               Int @id @default(autoincrement())
  prestamoId       Int
  prestamoPiezaId  Int @unique
  usuarioId        Int
  encargadoId      Int
  tipo             String
  descripcion      String
  estado           String @default("PENDIENTE")
  creadoEn         DateTime @default(now())
  prestamo         Prestamo @relation(fields: [prestamoId], references: [id])
  piezaPrestamo    PrestamoPieza @relation(fields: [prestamoPiezaId], references: [id])
  usuario          Usuario @relation(fields: [usuarioId], references: [id])
  adeudo           Adeudo?
  @@index([usuarioId, estado])
  @@index([tipo, creadoEn])
}

model Adeudo {
  id           Int @id @default(autoincrement())
  incidenciaId Int @unique
  usuarioId    Int
  estado       String @default("PENDIENTE")
  creadoEn     DateTime @default(now())
  liquidadoEn  DateTime?
  notas        String?
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id])
  usuario      Usuario @relation(fields: [usuarioId], references: [id])
  convenios    Convenio[]
  @@index([usuarioId, estado])
}

model Convenio {
  id               Int @id @default(autoincrement())
  adeudoId         Int
  usuarioId        Int
  descripcion      String
  fechaCreacion    DateTime @default(now())
  fechaLimite      DateTime
  estado           String @default("ACTIVO")
  fechaLiquidacion DateTime?
  comprobante      String?
  adeudo           Adeudo @relation(fields: [adeudoId], references: [id])
  usuario          Usuario @relation(fields: [usuarioId], references: [id])
  @@index([estado, fechaLimite])
  @@index([usuarioId])
}

model Notificacion {
  id        Int @id @default(autoincrement())
  usuarioId Int
  tipo      String
  mensaje   String
  clave     String? @unique
  leida     Boolean @default(false)
  creadoEn  DateTime @default(now())
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  @@index([usuarioId, creadoEn])
}

model Interes {
  id         Int @id @default(autoincrement())
  usuarioId  Int
  materialId Int
  usuario    Usuario @relation(fields: [usuarioId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])
  @@unique([usuarioId, materialId])
}

model Aviso {
  id        Int @id @default(autoincrement())
  titulo    String
  contenido String
  activo    Boolean @default(true)
  creadoEn  DateTime @default(now())
}

model Actividad {
  id        Int @id @default(autoincrement())
  usuarioId Int?
  nombre    String
  rol       String
  fecha     DateTime @default(now())
  accion    String
  modulo    String
  detalle   Json?
  @@index([modulo, fecha])
  @@index([usuarioId, fecha])
}

model Configuracion {
  id                        Int @id @default(1)
  toleranciaMinutos          Int @default(15)
  anticipacionMaxHoras       Int @default(168)
  anticipacionMinMinutos     Int @default(0)
  horaApertura              String @default("07:00")
  horaCierre                String @default("20:00")
  avisoVencimientoMinutos   Int @default(60)
}

model Practica {
  id          Int @id @default(autoincrement())
  nombre      String @unique
  descripcion String @default("")
  materiales  Json
}
